# Terraform only reads .tf files in the *working directory*, so each environment
# needs its own copy of the provider requirements. The root ../../versions.tf
# documents the project-wide constraint policy; this file is what init enforces.

terraform {
  required_version = ">= 1.6.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}
