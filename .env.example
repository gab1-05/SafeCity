# ─────────────────────────────────────────────────────────────
# SafeCity — Environment configuration (example)
# Copy to .env and adjust. NEVER commit real .env files.
# ─────────────────────────────────────────────────────────────

# ---- Core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-64-random-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database (PostgreSQL) ----
POSTGRES_DB=safecity
POSTGRES_USER=safecity
POSTGRES_PASSWORD=change-me-local-only
DB_HOST=db
DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws/

# ---- JWT ----
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- Storage (S3-compatible). Leave empty to use local media dir ----
# MEDIA_BACKEND=local|s3
MEDIA_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
# Local S3-compatible (MinIO) endpoint
S3_ENDPOINT_URL=http://minio:9000

# ---- Email (console backend if empty) ----
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=safecity@example.local

# ---- AI (optional; mock provider used when empty) ----
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_TRANSLATION_ENABLED=true

# ---- CAPTCHA (optional interface; mock when empty) ----
CAPTCHA_PROVIDER=mock

# ---- Google OAuth (leave CLIENT_ID empty to disable OAuth sign-in) ----
GOOGLE_CLIENT_ID=

# ---- Malware scanning (optional interface; mock when empty) ----
MALWARE_SCAN_PROVIDER=mock

# ---- Feature flags ----
ALLOW_ANONYMOUS_REPORTS=true
EMERGENCY_MODE_ENABLED=true
# Approximate public coordinates by this many meters (privacy jitter)
PUBLIC_COORD_JITTER_METERS=150

# ---- Rate limits ----
RATE_LIMIT_ANON_PER_MIN=30
RATE_LIMIT_INCIDENTS_PER_HOUR=5

# ---- Superuser seed (local dev only!) ----
SEED_SUPERUSER_EMAIL=admin@safecity.local
SEED_SUPERUSER_PASSWORD=Admin@12345!
