# ─────────────────────────────────────────────────────────────
# SafeCity — Environment configuration (example)
# Copy to .env and adjust. NEVER commit real .env files.
# .env is excluded from git via .gitignore.
# ─────────────────────────────────────────────────────────────

# ============================================================
# CORE / DJANGO
# ============================================================
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-64-random-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://localhost:18081
BACKEND_PORT=18081
FRONTEND_PORT=5174

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_DB=safecity
POSTGRES_USER=safecity
POSTGRES_PASSWORD=change-me-local-only
DB_HOST=db
DB_PORT=5432

# ============================================================
# REDIS / CELERY / CHANNELS
# ============================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ============================================================
# FRONTEND (Vite / React)
# ============================================================
VITE_API_BASE_URL=http://localhost:18081/api/v1
VITE_WS_URL=ws://localhost:18081/ws/

# ============================================================
# JWT
# ============================================================
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ============================================================
# STORAGE (S3-compatible). Leave empty to use local media dir
# ============================================================
MEDIA_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://minio:9000

# ============================================================
# EMAIL (console backend if empty)
# ============================================================
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=safecity@example.local

# ============================================================
# AI (optional; mock provider used when empty)
# ============================================================
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_TRANSLATION_ENABLED=true

# ============================================================
# CAPTCHA (optional interface; mock when empty)
# ============================================================
CAPTCHA_PROVIDER=mock

# ============================================================
# GOOGLE OAuth
# Leave CLIENT_ID empty to disable OAuth sign-in.
# Production: set to your Google Cloud OAuth Client ID
# ============================================================
GOOGLE_CLIENT_ID=

# ============================================================
# MALWARE SCANNING (optional interface; mock when empty)
# ============================================================
MALWARE_SCAN_PROVIDER=mock

# ============================================================
# FEATURE FLAGS
# ============================================================
ALLOW_ANONYMOUS_REPORTS=true
EMERGENCY_MODE_ENABLED=true
PUBLIC_COORD_JITTER_METERS=150

# ============================================================
# RATE LIMITS
# ============================================================
RATE_LIMIT_ANON_PER_MIN=30
RATE_LIMIT_INCIDENTS_PER_HOUR=5

# ============================================================
# SUPERUSER SEED (local dev only!)
# ============================================================
SEED_SUPERUSER_EMAIL=admin@safecity.local
SEED_SUPERUSER_PASSWORD=Admin@12345!

# ============================================================
# PRODUCTION-ONLY (Render / Koyeb deployments)
# Uncomment and set when deploying to production:
# ============================================================
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DEBUG=false
# ALLOWED_HOSTS=safecity-xxx.onrender.com,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://safecity-xxx.onrender.com,http://localhost:5174
# VITE_API_BASE_URL=https://safecity-xxx.onrender.com/api/v1
# VITE_WS_URL=wss://safecity-xxx.onrender.com/ws/
# PUBLIC_URL=https://safecity-xxx.onrender.com
# SECRET_KEY=<64-char-random-string-for-production>
# GOOGLE_CLIENT_ID=570850423686-n4kk5t2j4k74fb3updeqoim6sji79opi.apps.googleusercontent.com
# DATABASE_URL=<render-provided-postgres-url>
# REDIS_URL=<render-provided-redis-url>
# CELERY_BROKER_URL=<render-provided-redis-url>
# EMAIL_HOST=<your-smtp-host>
# EMAIL_HOST_USER=<your-smtp-user>
# EMAIL_HOST_PASSWORD=<your-smtp-password>
# OPENAI_API_KEY=<your-openai-key-if-using-ai>
# AWS_ACCESS_KEY_ID=<your-aws-access-key-if-using-s3>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret-key-if-using-s3>
# AWS_S3_BUCKET=<your-s3-bucket-if-using-s3>
