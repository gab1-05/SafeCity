# ---- Secrets / env ----
.env
.env.*
!.env.example
*.pem
*.key
# Root-anchored: a bare "secrets/" pattern would also ignore the
# infrastructure/terraform/modules/secrets/ Terraform module.
/secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
backend/media/
backend/staticfiles/

# ---- Node / Frontend ----
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/
.turbo/

# ---- Terraform ----
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/terraform.tfstate*
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/terraform.tfvars.example
.terraform.lock.hcl

# ---- Docker / misc ----
*.log
results/
.DS_Store
Thumbs.db
.idea/
.vscode/
!/.vscode/extensions.json
minio_data/
celerybeat-schedule

# ---- Generated presentations ----
*.pptx
~$*
